apiVersion: v1
kind: Config
clusters:
  - name: {{ name }}
    cluster:
      server: {{ server }}
      certificate-authority-data: {{ ca_cert_b64 }}
users:
  - name: console-pilot
    user:
      token: {{ token }}
contexts:
  - name: {{ name }}
    context:
      cluster: {{ name }}
      user: console-pilot
current-context: {{ name }}
